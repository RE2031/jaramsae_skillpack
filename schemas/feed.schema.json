{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "goal",
    "style",
    "brand",
    "draft",
    "posts"
  ],
  "additionalProperties": false,
  "properties": {
    "institution": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string"
    },
    "style": {
      "enum": [
        "photo-lifestyle",
        "emotional-editorial",
        "modern-magazine",
        "minimal-information",
        "sunlit-editorial",
        "quiet-premium",
        "warm-lifestyle",
        "editorial-hybrid",
        "bold-photo-editorial"
      ]
    },
    "brand": {
      "type": "object",
      "required": [
        "primary",
        "background",
        "accent"
      ],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "draft": {
      "type": "boolean"
    },
    "posts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": [
          "category",
          "purpose",
          "caption",
          "hashtags",
          "slides"
        ],
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "hashtags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "slides": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "body",
                "layout"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "body": {
                  "type": "string",
                  "maxLength": 180
                },
                "layout": {
                  "enum": [
                    "photo",
                    "editorial",
                    "magazine",
                    "info",
                    "quote",
                    "checklist",
                    "hero-left-copy",
                    "hero-right-copy",
                    "split-editorial",
                    "quiet-cover",
                    "photo-caption",
                    "minimal-announcement",
                    "fullbleed-photo",
                    "split-photo",
                    "detail-photo",
                    "text-interlude"
                  ]
                },
                "image": {
                  "type": "string"
                },
                "image_approved": {
                  "type": "boolean"
                },
                "details": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "type": "string",
                    "maxLength": 48
                  }
                },
                "image_position": {
                  "enum": [
                    "left",
                    "center",
                    "right",
                    "top",
                    "bottom"
                  ]
                },
                "image_credit": {
                  "type": "string",
                  "maxLength": 80
                },
                "image_kind": {
                  "enum": [
                    "institution",
                    "stock",
                    "generated",
                    "provided"
                  ]
                },
                "eyebrow": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "image_source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "image_zoom": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 3
                },
                "image_focus_x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "image_focus_y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "aside": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 48
                },
                "video": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "subtitle": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "question": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 110
                }
              }
            },
            "minItems": 1,
            "maxItems": 6
          }
        }
      }
    },
    "editorial_variant": {
      "enum": [
        "signature",
        "modern",
        "story",
        "creative"
      ],
      "description": "Optional TIO-first visual edition for bold-photo-editorial; default signature preserves legacy styling."
    },
    "body_only": {
      "type": "boolean",
      "description": "Only article interiors, page numbers start at 02."
    },
    "body_style": {
      "enum": [
        "playful",
        "overlay",
        "video",
        "interview"
      ]
    },
    "logo": {
      "type": "string",
      "minLength": 1
    },
    "interview_source": {
      "type": "string",
      "maxLength": 20000
    },
    "issue": {
      "type": "string",
      "maxLength": 30
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "editorial_variant"
        ]
      },
      "then": {
        "properties": {
          "style": {
            "const": "bold-photo-editorial"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "body_only"
        ],
        "properties": {
          "body_only": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "style": {
            "const": "bold-photo-editorial"
          },
          "posts": {
            "items": {
              "properties": {
                "slides": {
                  "maxItems": 3
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "body_style"
        ]
      },
      "then": {
        "properties": {
          "style": {
            "const": "bold-photo-editorial"
          }
        }
      }
    }
  ],
  "anyOf": [
    {
      "required": [
        "display_name"
      ]
    },
    {
      "required": [
        "institution"
      ]
    }
  ]
}
