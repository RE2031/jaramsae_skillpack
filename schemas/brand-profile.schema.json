{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jaramsae institution brand profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "institution",
    "age_range",
    "education_philosophy",
    "strengths",
    "instagram_goals",
    "preferred_tone"
  ],
  "properties": {
    "institution": {
      "type": "string",
      "minLength": 1
    },
    "age_range": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "education_philosophy": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "instagram_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "preferred_tone": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "optional_brand_notes": {
      "type": "string"
    },
    "content_language": {
      "const": "ko"
    }
  }
}
